{
  "default-configuration": "Debug",
  "configurations": [
    "Debug",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "files": [
    { "kind": "folder", "path": "Driver", "target-membership": [ "Driver" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Driver.xctest", "id": "000000000000000000000120", "type": "wrapper.cfbundle", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Driver",
      "id": "000000000000000100000000",
      "product": "Products/Driver.xctest",
      "product-type": "bundle.ui-testing",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "CODE_SIGN_STYLE": "Automatic",
        "GENERATE_INFOPLIST_FILE": "YES",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.0",
        "PRODUCT_BUNDLE_IDENTIFIER": "app.tubeless.ScreenshotDriver",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SDKROOT": "iphoneos",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
    "CLANG_ENABLE_MODULES": "YES",
    "ENABLE_USER_SCRIPT_SANDBOXING": "YES",
    "ONLY_ACTIVE_ARCH": "YES",
    "SWIFT_OPTIMIZATION_LEVEL": "-Onone",
  },
  "last-upgrade": "27.2",
  "last-swift-update": "27.2",
}
